# Copy to .env and fill in. Never commit .env.

# YouTube Studio > Go live > Stream > Stream key.
YOUTUBE_STREAM_KEY=

# Optional but recommended: a fine-grained GitHub token with no extra permissions
# (public repositories, read-only). Raises the API limit from 60 to 5,000 requests per hour,
# which makes the PR feed, CI and counters refresh every few minutes.
GITHUB_TOKEN=

# Video settings. The 1920x1080 page is rendered at WIDTH x HEIGHT: 1440p makes YouTube
# serve its sharper VP9 encodes, 1080p included. YouTube needs a steady stream: 30 fps at a
# constant bitrate (at 5 fps or a variable bitrate it reports "not receiving enough video").
# The scenes and alerts move, so the screen is captured at the full frame rate. A lower CAPTURE_FPS
# repeats frames up to FPS, which saves some CPU but makes the animations stutter.
WIDTH=2560
HEIGHT=1440
FPS=30
CAPTURE_FPS=30
VIDEO_BITRATE=12000k
BUFSIZE=24000k
AUDIO_BITRATE=128k
PRESET=superfast
PAGE=

# Local preview port (bound to 127.0.0.1 only).
DASHBOARD_PORT=8080
TZ=Europe/Paris

# Like goal on screen (optional): an API key and the live's video ID.
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=

# Chat commands (optional, needs the two values above): viewers type !game <name>, !lib <name>, !next, !top,
# !random, !discord or !help and the answer appears on screen. The chat is read through YouTube's stream, 5 of the
# key's 10,000 daily units per opening, every CHAT_POLL_SECONDS. After a command it stays open for
# CHAT_BURST_MINUTES, for fast answers, within CHAT_DAILY_UNITS a day.
CHAT_COMMANDS=0
CHAT_POLL_SECONDS=75
CHAT_BURST_MINUTES=3
CHAT_DAILY_UNITS=8000
# A reminder of the commands, posted in the chat as the channel (50 units each, 0 turns it off). It needs the
# OAuth values below with the youtube.force-ssl scope.
CHAT_REMINDER_MINUTES=60

# Daily Short: recorded at this hour, and uploaded when the OAuth values are set (see the README).
SHORTS=1
SHORT_HOUR_UTC=18
SHORT_PRIVACY=public
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
